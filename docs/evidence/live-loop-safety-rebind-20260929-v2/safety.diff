+def human_takeover_guard(get_state=None):
+    """Reuse the calibration tool's all-key/mouse poll, without input injection."""
+    from .camera_calibration import human_input
+    if get_state is None:
+        import ctypes
+        user32 = ctypes.WinDLL("user32", use_last_error=True)
+        user32.GetAsyncKeyState.argtypes = [ctypes.c_int]
+        user32.GetAsyncKeyState.restype = ctypes.c_short
+        get_state = user32.GetAsyncKeyState
+    return lambda: human_input(get_state)
+
+
+class LiveSafety:
+    """One latched scope for startup, gameplay and scoreboard, including stalls.
+
+    The monitor polls only desktop state and time, never concurrent capture.
+    Pixel proofs check HUD/idle on each acquired frame; Live keeps its existing
+    commit-time freshness and lease. Closing Live disarms future writes under
+    its actuator lock, even if a blocked capture or brain later returns.
+    """
+    def __init__(self, focused, takeover, deadline, *, clock=None):
+        if not math.isfinite(deadline):
+            raise ValueError("finite live deadline required")
+        self.focused, self.takeover, self.deadline = focused, takeover, deadline
+        self.clock = clock or time.perf_counter
+        self.status = {"stop_reason": None, "close_returned": False, "errors": []}
+        self.live = None
+        self._lock, self._close_lock = threading.Lock(), threading.Lock()
+        self._done = threading.Event()
+        self._thread = None
+        self._scoreboard_until = None
+
+    def begin_scoreboard(self, hold_s):
+        # Live still requires a true range proof before pressing BACK and uses
+        # its own RETURN_S limit after release. This only suspends the latch;
+        # it never turns a negative proof into permission to send input.
+        from .controller import FRESH_S, RETURN_S
+        if not math.isfinite(hold_s) or hold_s < 0:
+            raise ValueError("finite nonnegative scoreboard hold required")
+        with self._lock:
+            if self._scoreboard_until is not None:
+                raise RuntimeError("scoreboard transition already active")
+            self._scoreboard_until = min(self.deadline, self.clock() + hold_s + RETURN_S + 2 * FRESH_S)
+
+    def end_scoreboard(self):
+        with self._lock:
+            self._scoreboard_until = None
+
+    def check(self):
+        # Serialize GetAsyncKeyState's consuming transition bits. A detected tap
+        # is latched, so a simultaneous frame proof cannot miss it.
+        with self._lock:
+            if self.status["stop_reason"] is None:
+                try:
+                    now = self.clock()
+                    reason = ("deadline" if not math.isfinite(now) or now >= self.deadline else
+                              "focus_lost" if self.focused() is not True else
+                              "human_takeover" if self.takeover() else None)
+                except Exception as e:
+                    reason = "safety_check_error"
+                    self.status["errors"].append(repr(e))
+                self.status["stop_reason"] = reason
+            stopped = self.status["stop_reason"] is not None
+        if stopped:
+            self._close_live()
+        return not stopped
+
+    def stop(self, reason):
+        with self._lock:
+            self.status["stop_reason"] = self.status["stop_reason"] or reason
+        self._close_live()
+
+    def _close_live(self):
+        with self._close_lock:
+            if self.live is not None and not self.status["close_returned"]:
+                try:
+                    self.live.close()
+                except Exception as e:
+                    self.status["errors"].append(f"close: {e!r}")
+                else:
+                    self.status["close_returned"] = True
+
+    def bind(self, live):
+        with self._close_lock:
+            self.live = live
+        if not self.check():
+            raise RangeLost(f"live scope stopped during attach: {self.status['stop_reason']}")
+
+    def start(self):
+        if not self.check():
+            raise RangeLost(f"live scope refused: {self.status['stop_reason']}")
+        self._thread = threading.Thread(target=self._monitor, daemon=True, name="loop-live-safety")
+        self._thread.start()
+
+    def _monitor(self):
+        while not self._done.wait(.01):
+            if not self.check():
+                return
+
+    def proof(self, reader, idle, *, range_required=False):
+        def proof(frame):
+            if not self.check():
+                return False
+            try:
+                if idle(frame):
+                    self.stop("idle_warning")
+                    return False
+                valid = bool(reader(frame))
+            except Exception:
+                self.stop("pixel_guard_error")
+                raise
+            # A negative board test may still be a valid scoreboard transition;
+            # Live tries the session/banner proof before refusing that frame.
+            if range_required and not valid:
+                with self._lock:
+                    transitioning = self._scoreboard_until is not None and self.clock() < self._scoreboard_until
+                if not transitioning:
+                    self.stop("range_lost")
+            return self.check() and valid
+        return proof
+
+    def close(self):
+        self._done.set()
+        self._close_live()
+        if self._thread is not None and self._thread.is_alive() and self._thread is not threading.current_thread():
+            self._thread.join(timeout=1)
+        if self.live is not None and not self.status["close_returned"]:
+            raise RuntimeError(f"live safety could not confirm release: {self.status['errors']}")
+
+
+def _open_live_io(safety, percept, board, session):
+    from .controller import Live
+    safety.start()  # before attach: a stop during construction remains latched
+    native = Live(guard=safety.proof(percept.in_range, percept.idle, range_required=True),
+                  board_guard=safety.proof(board, percept.idle),
+                  session_guard=safety.proof(session, percept.idle), settle_s=0)
+    try:
+        safety.bind(native)
+        return LiveIO(native, safety=safety)
+    except BaseException:
+        native.close()
+        raise
+
