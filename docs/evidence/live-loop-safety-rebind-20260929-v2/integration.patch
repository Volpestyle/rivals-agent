+@pytest.mark.parametrize('change', ['record', 'evidence', 'map', 'settings', 'missing_evidence', 'missing_record', 'scope'])
+def test_reviewed_record_pins_whole_map_settings_and_evidence(tmp_path, monkeypatch, change):
+    path = synthetic_map(tmp_path)
+    path, profile, receipt, evidence = reviewed(tmp_path, monkeypatch, path)
+    if change in ('record', 'evidence', 'map'):
+        target = {'record': receipt, 'evidence': evidence, 'map': path}[change]
+        target.write_bytes(target.read_bytes() + b' ')
+    elif change == 'missing_evidence':
+        evidence.unlink()
+    elif change == 'missing_record':
+        receipt.unlink()
+    else:
+        record = json.loads(receipt.read_text())
+        record['settings' if change == 'settings' else 'scope'] = 'wrong'
+        receipt.write_text(json.dumps(record))
+        # Even a trusted record must match the map's settings and whole-map scope.
+        A.REVIEWED_ACCEPTANCES[profile] = (receipt.name, hashlib.sha256(receipt.read_bytes()).hexdigest())
+    with pytest.raises(CameraMapError):
+        Cal.from_profile(path, live=True, settings_match=profile)
