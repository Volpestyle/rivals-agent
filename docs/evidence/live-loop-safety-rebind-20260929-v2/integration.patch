+"""Pending integration checks, all fake input and synthetic maps."""
+import json
+import math
+import pytest
+from agent.camera_map import MAPS, LEGACY
+from agent.controller import Cal, Controller, NEUTRAL
+from agent.intents import Search, Disengage, Engage, Idle
+from agent.state import State, Detection, ENEMY
+
+
+def synthetic_map(tmp_path, candidate=False):
+    data=json.loads((MAPS / (LEGACY+'.json')).read_text())
+    data['profile']='synthetic-asymmetric'
+    data['focal']['value']=600.
+    for axis in ('yaw','pitch'):
+        for direction,factor in [('positive',.5),('negative',.25)]:
+            for point in data[axis][direction]:
+                point['measurement']['value']*=factor
+                if candidate:
+                    point['measurement']['status']='candidate'
+    path=tmp_path/'synthetic.json'
+    path.write_text(json.dumps(data))
+    return path
+
+
+def test_legacy_profile_outputs_match_default_controller():
+    old, mapped = Controller(), Controller(cal=Cal.from_profile())
+    bot=Detection(ENEMY,(630,300,650,420),.9)
+    for i in range(1500):
+        intent=(Search() if i<400 else Disengage() if i<500 else Engage(bot) if i<900 else Idle())
+        state=State(t=i/60,frame=(1280,720),detections=[bot])
+        assert mapped.step(state,intent)==old.step(state,intent)
+        assert mapped.cam==pytest.approx(old.cam)
+
+
+def test_signed_map_controls_prediction_and_aim_geometry(tmp_path):
+    cal=Cal.from_profile(synthetic_map(tmp_path))
+    c=Controller(cal=cal)
+    c.stick=(-.45,-.5)
+    c._advance(1.,.1)
+    assert c.cam==pytest.approx([-4.3,-1.075])
+    assert cal.stick_for('yaw',-43)==-.45
+    assert cal.stick_for('yaw',86)==.45
+    bot=Detection(ENEMY,(710,350,730,370),.9)
+    c=Controller(cal=cal)
+    c.aim_only(State(t=0.,frame=(1280,720),detections=[bot]),bot)
+    assert c.track.yaw==pytest.approx(math.degrees(math.atan2(80,600)))
+
+
+def test_search_relevel_and_disengage_scale_with_current_map(tmp_path):
+    cal=Cal.from_profile(synthetic_map(tmp_path))
+    c=Controller(cal=cal)
+    c.step(State(t=0.,frame=(1280,720)),Search())
+    assert c.step(State(t=4.,frame=(1280,720)),Search())['ry']==1
+    assert c.step(State(t=6.,frame=(1280,720)),Search())['ry']==-.5
+    d=Controller(cal=cal)
+    d.step(State(t=0.,frame=(1280,720)),Disengage())
+    assert d.step(State(t=.6,frame=(1280,720)),Disengage())['rx']==1
+    assert d.step(State(t=1.,frame=(1280,720)),Disengage())['ly']==1
+
+
