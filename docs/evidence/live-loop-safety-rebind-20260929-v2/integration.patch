+@pytest.mark.parametrize('axis,direction', [('yaw','positive'), ('yaw','negative'), ('pitch','positive'), ('pitch','negative')])
+def test_slow_maps_refuse_before_any_timed_hold(tmp_path, monkeypatch, axis, direction):
+    path = synthetic_map(tmp_path)
+    data = json.loads(path.read_text())
+    for point in data[axis][direction]:
+        point['measurement']['value'] *= .99 if direction == 'negative' else .49
+    path.write_text(json.dumps(data))
+    path, profile, _, _ = reviewed(tmp_path, monkeypatch, path)
+    with pytest.raises(CameraMapError, match='4x legacy local bound'):
+        Cal.from_profile(path, live=True, settings_match=profile)
+    with pytest.raises(CameraMapError, match='4x legacy local bound'):
+        Cal.from_profile(path)
