+def reviewed(tmp_path, monkeypatch, path=None):
+    path = path or MAPS / (LEGACY + '.json')
+    camera = json.loads(path.read_text())
+    evidence = tmp_path / 'measurement.txt'
+    evidence.write_text('synthetic reviewed evidence; not a real calibration')
+    record = dict(schema='rivals-camera-acceptance-v1', scope='controller_complete',
+                  profile=camera['profile'], settings=camera['settings'],
+                  map_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),
+                  evidence={evidence.name: hashlib.sha256(evidence.read_bytes()).hexdigest()})
+    receipt = tmp_path / 'acceptance.json'
+    receipt.write_text(json.dumps(record))
+    registry = {camera['profile']: (receipt.name, hashlib.sha256(receipt.read_bytes()).hexdigest())}
+    monkeypatch.setattr(A, 'ROOT', tmp_path)
+    monkeypatch.setattr(A, 'REVIEWED_ACCEPTANCES', registry)
+    return path, camera['profile'], receipt, evidence
+
